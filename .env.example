# Safe Prompt — Environment Configuration
# Copy to .env and fill in values

# QoreChain network
QORECHAIN_NETWORK=qorechain-diana
QORECHAIN_CHAIN_ID=9800
QORECHAIN_RPC_URL=https://diana-rpc.qorechain.io
QORECHAIN_EXPLORER_URL=https://explorer.qorechain.io

# On-chain registry addresses
QORECHAIN_KEM_REGISTRY_ADDRESS=
QORECHAIN_ML_DSA_REGISTRY_ADDRESS=

# SafePromptAnchor contract on Diana testnet (chain 9800)
# Set QORECHAIN_ANCHOR_CONTRACT_ADDRESS after deploying contracts/scripts/deploy.ts
QORECHAIN_ANCHOR_CONTRACT_ADDRESS=

# Contract deployment (set by the deployer — keep out of version control)
QORECHAIN_PRIVATE_KEY=
QORECHAIN_DIANA_RPC_URL=https://diana-rpc.qorechain.io
QORECHAIN_EXPLORER_API_KEY=

# Gateway
SAFE_PROMPT_GATEWAY_HOST=127.0.0.1
SAFE_PROMPT_GATEWAY_PORT=8787
SAFE_PROMPT_WEB_PORT=8080
SAFE_PROMPT_UPSTREAM_LLM_URL=
SAFE_PROMPT_UPSTREAM_API_KEY=
SAFE_PROMPT_DEFAULT_MODEL=qorechain-mock-model
SAFE_PROMPT_LOCAL_MODEL=

# TUI
SAFE_PROMPT_SESSION=tui
SAFE_PROMPT_HOME=/home/$(whoami)/.safe-prompt
SAFE_PROMPT_FAIL_CLOSED=true

# Rust crypto core
SAFE_PROMPT_USE_RUST=true
